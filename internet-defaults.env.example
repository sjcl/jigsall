# Copy to internet-defaults.env (Git ignored), edit, then rebuild with rendezvous.
# Plain KEY=value syntax; no quotes, variable expansion or inline comments.
# Public values only. Never add TURN passwords, provider secrets or auth tokens.
# Release Actions writes the same three keys from repository Variables; see
# docs/PRE_RELEASE_CHECKLIST.md. A configured WSS endpoint is required for release.
JIGSALL_RENDEZVOUS_WSS_URL=wss://your-rendezvous.example/v1/ws
JIGSALL_ICE_STUN_SERVERS=stun:your-stun.example:3478
JIGSALL_ICE_ALLOW_PUBLIC_CANDIDATES=true
